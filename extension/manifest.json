{
  "manifest_version": 3,
  "name": "CATFOOD Atom + Boost for ChatGPT",
  "version": "0.5.55",
  "description": "Local ChatGPT Web performance observer with optional presentation-safe boost controls.",
  "permissions": [
    "webRequest",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8767/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "boost.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CATFOOD Atom + Boost for ChatGPT",
    "default_popup": "popup.html"
  }
}
