{
  "manifest_version": 3,
  "name": "CATFOOD Atom for ChatGPT",
  "version": "0.3.2",
  "description": "A local, privacy-preserving performance observer for ChatGPT Web.",
  "permissions": [
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "CATFOOD Atom for ChatGPT",
    "default_popup": "popup.html"
  }
}
